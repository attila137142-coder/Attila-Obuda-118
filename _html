<!DOCTYPE html>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script>
// ===== MAP =====
var map = L.map('map').setView([47.4979,19.0402],13);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

let marker = L.circleMarker([47.4979,19.0402],{radius:8,color:'red'}).addTo(map);

// ===== GTFS STORAGE =====
let gtfs = {
  stops: [],
  routes: [],
  trips: [],
  stop_times: []
};

// ===== GTFS LOAD =====
function loadGTFS(){
  const file = document.getElementById('gtfsFile').files[0];
  if(!file){alert('Nincs fájl!');return;}

  JSZip.loadAsync(file).then(zip=>{
    zip.file("stops.txt").async("string").then(data=>{
      gtfs.stops = parseCSV(data);
      log("Stops betöltve: " + gtfs.stops.length);
    });

    zip.file("stop_times.txt").async("string").then(data=>{
      gtfs.stop_times = parseCSV(data);
      log("Stop_times betöltve");
    });
  });
}

// ===== CSV PARSER =====
function parseCSV(text){
  const lines = text.split("\n");
  const headers = lines[0].split(",");
  return lines.slice(1).map(l=>{
    let obj={};
    let vals=l.split(",");
    headers.forEach((h,i)=>obj[h]=vals[i]);
    return obj;
  });
}

// ===== ROUTING (SIMPLE STOP MATCH) =====
function route(){
  let from=document.getElementById('from').value.toLowerCase();
  let to=document.getElementById('to').value.toLowerCase();

  let f = gtfs.stops.find(s=> (s.stop_name||"").toLowerCase().includes(from));
  let t = gtfs.stops.find(s=> (s.stop_name||"").toLowerCase().includes(to));

  if(!f||!t){
    document.getElementById('routeOut').innerText="❌ Nem található indulás vagy cél";
    return;
  }

  let line = "🟡 Talált stopok:\n"+f.stop_name+" → "+t.stop_name;
  document.getElementById('routeOut').innerText=line;

  L.marker([f.stop_lat,f.stop_lon]).addTo(map).bindPopup("INDULÁS").openPopup();
  L.marker([t.stop_lat,t.stop_lon]).addTo(map).bindPopup("CÉL");
}

// ===== GPS =====
navigator.geolocation.watchPosition(pos=>{
  let lat=pos.coords.latitude;
  let lon=pos.coords.longitude;
  let speed=pos.coords.speed||0;

  marker.setLatLng([lat,lon]);
  map.setView([lat,lon]);

  document.getElementById('kmh').innerText=(speed*3.6).toFixed(1)+" km/h";
  document.getElementById('coords').innerText=lat.toFixed(5)+","+lon.toFixed(5);
});

function log(t){document.getElementById('log').innerText=t;}
</script>

</body>
</html>
